if not df_pay.empty:
    print(f"\n【PAYMENT 名称规范化追踪】\n")
    for idx, row in df_pay.iterrows():
        name = row["Client_Name"]
        print(f"Record #{idx+1}: {name}")
        
        # Strict 规范化
        strict_result, strict_steps = trace_normalize_strict(name)
