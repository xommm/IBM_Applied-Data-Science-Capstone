from ayx import Alteryx
import pandas as pd
import numpy as np
import re
import unicodedata
from decimal import Decimal, ROUND_HALF_UP

# ==========================================
# 0. 排查配置项
# ==========================================
TARGET_KEYWORD = "联合利华"

# ==========================================
# 1. 清洗与转换函数定义（带详细日志）
# ==========================================
def normalize_name_strict(value, show_steps=False):
    if pd.isna(value):
        if show_steps: print(f"  [Strict] 输入为 NaN → None")
        return None
    
    s = str(value).replace("\x00", "").replace("\ufeff", "")
    if show_steps: print(f"  [Strict-1] 移除控制字符: '{value}' → '{s}'")
    
    text = unicodedata.normalize("NFKC", s).strip()
    if show_steps: print(f"  [Strict-2] Unicode规范化+strip: '{s}' → '{text}'")
    
    if not text:
        if show_steps: print(f"  [Strict] 结果为空 → None")
        return None
    
    text = re.sub(r"[\u200B-\u200D\uFEFF\u00A0]", "", text)
    if show_steps: print(f"  [Strict-3] 移除隐形空格: → '{text}'")
    
    text = re.sub(r"\s+", "", text).lower()
    if show_steps: print(f"  [Strict-4] 去空格+小写: → '{text}'")
    
    text = text.replace("（", "(").replace("）", ")")
    if show_steps: print(f"  [Strict-5] 中文括号→英文括号: → '{text}'")
    
    text = re.sub(r"[^0-9a-zA-Z\u4e00-\u9fff\(\)\-\,\.\u00b7]", "", text)
    if show_steps: print(f"  [Strict-6] 清理特殊字符(仅保留中英数+括号): → '{text}'")
    
    result = text if text else None
    if show_steps: print(f"  [Strict] 最终结果: {result}\n")
    return result

def normalize_name_fuzzy(value, show_steps=False):
    if pd.isna(value):
        if show_steps: print(f"  [Fuzzy] 输入为 NaN → None")
        return None
    
    s = str(value).replace("\x00", "").replace("\ufeff", "")
    if show_steps: print(f"  [Fuzzy-1] 移除控制字符: '{value}' → '{s}'")
    
    text = unicodedata.normalize("NFKC", s).strip().lower()
    if show_steps: print(f"  [Fuzzy-2] Unicode规范化+strip+小写: → '{text}'")
    
    if not text:
        if show_steps: print(f"  [Fuzzy] 结果为空 → None")
        return None
    
    text = re.sub(r"[^\w\u4e00-\u9fff]", "", text)
    if show_steps: print(f"  [Fuzzy-3] 清理非中英数字: → '{text}'")
    
    suffixes = ["有限责任公司", "股份有限公司", "有限公司", "责任公司", "分公司", "公司", "中国", "上海分行", "分行"]
    original_text = text
    for sfx in suffixes:
        if sfx in text:
            text = text.replace(sfx, "")
            if show_steps: print(f"  [Fuzzy-4] 移除后缀 '{sfx}': → '{text}'")
    
    if original_text == text and show_steps:
        print(f"  [Fuzzy-4] 无匹配的后缀需移除")
    
    result = text if text else None
    if show_steps: print(f"  [Fuzzy] 最终结果: {result}\n")
    return result

def normalize_name_aggressive(value, show_steps=False):
    if pd.isna(value):
        if show_steps: print(f"  [Aggressive] 输入为 NaN → None")
        return None
    
    s = str(value).replace("\x00", "").replace("\ufeff", "")
    if show_steps: print(f"  [Aggressive-1] 移除控制字符: '{value}' → '{s}'")
    
    text = unicodedata.normalize("NFKC", s).strip().lower()
    if show_steps: print(f"  [Aggressive-2] Unicode规范化+strip+小写: → '{text}'")
    
    text = re.sub(r"[^0-9a-zA-Z\u4e00-\u9fff]", "", text)
    if show_steps: print(f"  [Aggressive-3] 只保留中英数字(去所有标点): → '{text}'")
    
    result = text if text else None
    if show_steps: print(f"  [Aggressive] 最终结果: {result}\n")
    return result

def to_cents(value, show_steps=False):
    if pd.isna(value):
        if show_steps: print(f"  [金额] 输入为 NaN → None")
        return None

    if show_steps: print(f"  [金额-1] 原始输入: {value} (类型: {type(value).__name__})")

    if isinstance(value, (float, np.floating)):
        if np.isnan(value) or np.isinf(value):
            if show_steps: print(f"  [金额] NaN 或 Inf → None")
            return None
        num_str = f"{value:.2f}"
        if show_steps: print(f"  [金额-2] Float格式化为2位: {num_str}")
    elif isinstance(value, (int, np.integer)):
        num_str = str(value)
        if show_steps: print(f"  [金额-2] Integer转字符串: {num_str}")
    else:
        s = unicodedata.normalize("NFKC", str(value)).strip()
        if show_steps: print(f"  [金额-2a] 字符串Unicode规范化: '{value}' → '{s}'")
        
        if not s:
            if show_steps: print(f"  [金额] 结果为空 → None")
            return None

        s = s.replace("\x00", "").replace("\ufeff", "").replace(",", "")
        if show_steps: print(f"  [金额-2b] 移除控制字符和逗号: → '{s}'")
        
        s = s.replace("￥", "").replace("$", "").replace("¥", "").replace("CNY", "")
        if show_steps: print(f"  [金额-2c] 移除货币符号: → '{s}'")
        
        s = s.replace("．", ".").replace("。", ".")
        if show_steps: print(f"  [金额-2d] 统一小数点: → '{s}'")

        if s.startswith("(") and s.endswith(")"):
            s = "-" + s[1:-1]
            if show_steps: print(f"  [金额-2e] 括号表负数转换: → '{s}'")

        m = re.search(r"[-]?\d+(\.\d+)?([eE][+-]?\d+)?", s)
        if not m:
            if show_steps: print(f"  [金额] 无法提取数字 → None")
            return None
        num_str = m.group(0)
        if show_steps: print(f"  [金额-2f] 正则提取数字: → '{num_str}'")

    try:
        amt = Decimal(num_str).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
        cents = int(amt * 100)
        if show_steps: print(f"  [金额-3] Decimal转分: {amt} 元 → {cents} 分")
        return cents
    except Exception as e:
        if show_steps: print(f"  [金额] Decimal转换异常: {e} → None")
        return None

# ==========================================
# 2. 读取数据并筛选目标关键词
# ==========================================
df_prop_raw = Alteryx.read("#1")
df_pay_raw = Alteryx.read("#2")

df_prop_raw.columns = [str(c).strip() for c in df_prop_raw.columns]
df_pay_raw.columns = [str(c).strip() for c in df_pay_raw.columns]

mask_prop = df_prop_raw["Buyer Name (Local)"].astype(str).str.contains(TARGET_KEYWORD, case=False, na=False)
mask_pay = df_pay_raw["Client_Name"].astype(str).str.contains(TARGET_KEYWORD, case=False, na=False)

df_prop = df_prop_raw[mask_prop].copy()
df_pay = df_pay_raw[mask_pay].copy()

diag_logs = []

print(f"\n{'='*80}")
print(f"诊断开始：目标关键词 '{TARGET_KEYWORD}'")
print(f"{'='*80}\n")

# ==========================================
# 排查 1: 原始数据检索
# ==========================================
print(f"[1] 数据检索")
print(f"    Proposal 查到 {len(df_prop)} 条")
print(f"    Payment 查到 {len(df_pay)} 条\n")

if df_prop.empty or df_pay.empty:
    print(f"❌ 无法继续诊断（数据不足）\n")
else:
    # ==========================================
    # 排查 2: 名称规范化详细过程
    # ==========================================
    print(f"[2] 名称规范化过程详解\n")
    
    print("=" * 80)
    print("Proposal 记录名称规范化:")
    print("=" * 80)
    df_prop["strict_key"] = df_prop["Buyer Name (Local)"].apply(
        lambda x: normalize_name_strict(x, show_steps=False)
    )
    df_prop["fuzzy_key"] = df_prop["Buyer Name (Local)"].apply(
        lambda x: normalize_name_fuzzy(x, show_steps=False)
    )
    df_prop["aggressive_key"] = df_prop["Buyer Name (Local)"].apply(
        lambda x: normalize_name_aggressive(x, show_steps=False)
    )
    
    for idx, row in df_prop.iterrows():
        print(f"\n  记录 {idx+1}: {row['Buyer Name (Local)']}")
        normalize_name_strict(row["Buyer Name (Local)"], show_steps=True)
        normalize_name_fuzzy(row["Buyer Name (Local)"], show_steps=True)
        normalize_name_aggressive(row["Buyer Name (Local)"], show_steps=True)

    print("\n" + "=" * 80)
    print("Payment 记录名称规范化:")
    print("=" * 80)
    df_pay["strict_key"] = df_pay["Client_Name"].apply(
        lambda x: normalize_name_strict(x, show_steps=False)
    )
    df_pay["fuzzy_key"] = df_pay["Client_Name"].apply(
        lambda x: normalize_name_fuzzy(x, show_steps=False)
    )
    df_pay["aggressive_key"] = df_pay["Client_Name"].apply(
        lambda x: normalize_name_aggressive(x, show_steps=False)
    )
    
    for idx, row in df_pay.iterrows():
        print(f"\n  记录 {idx+1}: {row['Client_Name']}")
        normalize_name_strict(row["Client_Name"], show_steps=True)
        normalize_name_fuzzy(row["Client_Name"], show_steps=True)
        normalize_name_aggressive(row["Client_Name"], show_steps=True)

    # ==========================================
    # 排查 3: 金额转换详细过程
    # ==========================================
    print("\n" + "=" * 80)
    print("金额转换过程详解")
    print("=" * 80)
    
    print("\nProposal 金额转换:")
    df_prop["cents"] = df_prop["Proposal Total Amount"].apply(
        lambda x: to_cents(x, show_steps=False)
    )
    
    for idx, row in df_prop.iterrows():
        print(f"\n  记录 {idx+1}:")
        to_cents(row["Proposal Total Amount"], show_steps=True)

    print("\nPayment 金额转换:")
    df_pay["cents"] = df_pay["Yesterday_Balance"].apply(
        lambda x: to_cents(x, show_steps=False)
    )
    
    for idx, row in df_pay.iterrows():
        print(f"\n  记录 {idx+1}:")
        to_cents(row["Yesterday_Balance"], show_steps=True)

    # ==========================================
    # 排查 4: Key 匹配分析
    # ==========================================
    print("\n" + "=" * 80)
    print("Key 匹配分析")
    print("=" * 80)
    
    prop_strict = set(df_prop["strict_key"].dropna().unique())
    pay_strict = set(df_pay["strict_key"].dropna().unique())
    strict_overlap = prop_strict.intersection(pay_strict)
    
    prop_fuzzy = set(df_prop["fuzzy_key"].dropna().unique())
    pay_fuzzy = set(df_pay["fuzzy_key"].dropna().unique())
    fuzzy_overlap = prop_fuzzy.intersection(pay_fuzzy)
    
    prop_aggressive = set(df_prop["aggressive_key"].dropna().unique())
    pay_aggressive = set(df_pay["aggressive_key"].dropna().unique())
    aggressive_overlap = prop_aggressive.intersection(pay_aggressive)

    print(f"\n[Strict Key]")
    print(f"  Proposal: {prop_strict}")
    print(f"  Payment:  {pay_strict}")
    print(f"  匹配:     {strict_overlap if strict_overlap else '❌ 无匹配'}")

    print(f"\n[Fuzzy Key]")
    print(f"  Proposal: {prop_fuzzy}")
    print(f"  Payment:  {pay_fuzzy}")
    print(f"  匹配:     {fuzzy_overlap if fuzzy_overlap else '❌ 无匹配'}")

    print(f"\n[Aggressive Key]")
    print(f"  Proposal: {prop_aggressive}")
    print(f"  Payment:  {pay_aggressive}")
    print(f"  匹配:     {aggressive_overlap if aggressive_overlap else '❌ 无匹配'}")

    # ==========================================
    # 排查 5: 金额对齐分析
    # ==========================================
    print("\n" + "=" * 80)
    print("金额对齐分析")
    print("=" * 80)
    
    print(f"\nProposal 金额汇总（正数）:")
    pos_prop_cents = df_prop[df_prop["cents"] > 0]["cents"].tolist()
    total_prop_cents = sum(pos_prop_cents)
    print(f"  单笔金额: {[c/100.0 for c in pos_prop_cents]}")
    print(f"  汇总:    {total_prop_cents / 100.0:.2f} 元 ({total_prop_cents} 分)")

    print(f"\nPayment 金额:")
    for idx, row in df_pay.iterrows():
        pay_cents = row["cents"]
        pay_raw = row["Yesterday_Balance"]
        print(f"  记录 {idx+1}: {pay_raw} → {pay_cents/100.0:.2f} 元 ({pay_cents} 分)")

    # ==========================================
    # 排查 6: 匹配结果清单
    # ==========================================
    print("\n" + "=" * 80)
    print("匹配结果清单")
    print("=" * 80)

    match_results = []

    # 尝试每种 Key 方式
    for key_type, key_col in [("Strict", "strict_key"), ("Fuzzy", "fuzzy_key"), ("Aggressive", "aggressive_key")]:
        print(f"\n【{key_type} Key 方式】")
        
        prop_by_key = {}
        for idx, row in df_prop.iterrows():
            key = row[key_col]
            if pd.notna(key):
                if key not in prop_by_key:
                    prop_by_key[key] = []
                prop_by_key[key].append(row)

        found_match = False
        for key, prop_rows in prop_by_key.items():
            pay_rows = df_pay[df_pay[key_col] == key]
            
            if pay_rows.empty:
                continue

            prop_sum = sum(r["cents"] for r in prop_rows if r["cents"] > 0)
            prop_ids = [r.get("proposal_key", idx) for idx, r in enumerate(prop_rows)]

            for _, pay_row in pay_rows.iterrows():
                pay_cents = pay_row["cents"]
                pay_id = pay_row.get("payment_key", "?")

                if pay_cents == prop_sum:
                    print(f"  ✅ 成功: {len(prop_rows)} Proposal ({prop_ids}) = 1 Payment ({pay_id})")
                    print(f"     金额: {prop_sum/100.0:.2f} 元 ✓")
                    match_results.append({
                        "Key方式": key_type,
                        "匹配状态": "✅ 成功",
                        "Payment_ID": pay_id,
                        "Payment金额(元)": f"{pay_cents/100.0:.2f}",
                        "Proposal_IDs": str(prop_ids),
                        "Proposal汇总(元)": f"{prop_sum/100.0:.2f}",
                        "记录数": f"{len(prop_rows)} + 1",
                        "说明": "完全匹配"
                    })
                    found_match = True
                else:
                    diff = abs(pay_cents - prop_sum)
                    print(f"  ❌ 失败: {len(prop_rows)} Proposal ({prop_ids}) ≠ 1 Payment ({pay_id})")
                    print(f"     差异: {diff/100.0:.2f} 元 (Payment {pay_cents/100.0:.2f} vs Proposal {prop_sum/100.0:.2f})")
                    match_results.append({
                        "Key方式": key_type,
                        "匹配状态": "❌ 失败",
                        "Payment_ID": pay_id,
                        "Payment金额(元)": f"{pay_cents/100.0:.2f}",
                        "Proposal_IDs": str(prop_ids),
                        "Proposal汇总(元)": f"{prop_sum/100.0:.2f}",
                        "记录数": f"{len(prop_rows)} + 1",
                        "说明": f"金额差异 {diff/100.0:.2f} 元"
                    })

        if not found_match:
            print(f"  🔍 未找到匹配")

print(f"\n{'='*80}\n")

# ==========================================
# 3. 输出到 Alteryx
# ==========================================
df_diag = pd.DataFrame(diag_logs)
df_match = pd.DataFrame(match_results)

# 第1个端口：诊断日志
Alteryx.write(df_diag if not df_diag.empty else pd.DataFrame({"说明": ["暂无诊断日志"]}), 1)

# 第2个端口：匹配清单
Alteryx.write(df_match if not df_match.empty else pd.DataFrame({"说明": ["暂无匹配结果"]}), 2)

# 第3个端口：数据明细
df_prop_detail = df_prop[["Buyer Name (Local)", "strict_key", "fuzzy_key", "aggressive_key", "Proposal Total Amount", "cents"]].copy()
df_prop_detail["数据来源"] = "Proposal"
df_pay_detail = df_pay[["Client_Name", "strict_key", "fuzzy_key", "aggressive_key", "Yesterday_Balance", "cents"]].copy()
df_pay_detail["数据来源"] = "Payment"

df_all_detail = pd.concat([df_prop_detail, df_pay_detail], ignore_index=True)
Alteryx.write(df_all_detail, 3)
