from ayx import Alteryx
import pandas as pd
import numpy as np
import re
import unicodedata
from decimal import Decimal, ROUND_HALF_UP

# ==========================================
# 0. 排查配置项
# ==========================================
TARGET_KEYWORD = "联合利华"
ENABLE_DEBUG = True

# ==========================================
# 1. 清洗与转换函数定义
# ==========================================
def normalize_name_strict(value):
    if pd.isna(value): return None
    s = str(value).replace("\x00", "").replace("\ufeff", "")
    text = unicodedata.normalize("NFKC", s).strip()
    if not text: return None
    text = re.sub(r"[\u200B-\u200D\uFEFF\u00A0]", "", text)
    text = re.sub(r"\s+", "", text).lower()
    text = text.replace("（", "(").replace("）", ")")
    text = re.sub(r"[^0-9a-zA-Z\u4e00-\u9fff\(\)\-\,\.\u00b7]", "", text)
    return text if text else None

def normalize_name_fuzzy(value):
    if pd.isna(value): return None
    s = str(value).replace("\x00", "").replace("\ufeff", "")
    text = unicodedata.normalize("NFKC", s).strip().lower()
    if not text: return None
    text = re.sub(r"[^\w\u4e00-\u9fff]", "", text)
    suffixes = ["有限责任公司", "股份有限公司", "有限公司", "责任公司", "分公司", "公司", "中国", "上海分行", "分行"]
    for sfx in suffixes:
        text = text.replace(sfx, "")
    return text if text else None

def normalize_name_aggressive(value):
    if pd.isna(value): return None
    s = str(value).replace("\x00", "").replace("\ufeff", "")
    text = unicodedata.normalize("NFKC", s).strip().lower()
    text = re.sub(r"[^0-9a-zA-Z\u4e00-\u9fff]", "", text)
    return text if text else None

def to_cents(value):
    if pd.isna(value): return None
    if isinstance(value, (float, np.floating)):
        if np.isnan(value) or np.isinf(value): return None
        num_str = f"{value:.2f}"
    elif isinstance(value, (int, np.integer)):
        num_str = str(value)
    else:
        s = unicodedata.normalize("NFKC", str(value)).strip()
        if not s: return None
        s = s.replace("\x00", "").replace("\ufeff", "").replace(",", "")
        s = s.replace("￥", "").replace("$", "").replace("¥", "").replace("CNY", "")
        s = s.replace("．", ".").replace("。", ".")
        if s.startswith("(") and s.endswith(")"): s = "-" + s[1:-1]
        m = re.search(r"[-]?\d+(\.\d+)?([eE][+-]?\d+)?", s)
        if not m: return None
        num_str = m.group(0)
    try:
        amt = Decimal(num_str).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
        return int(amt * 100)
    except Exception:
        return None

# ==========================================
# 2. 逐步规范化跟踪函数（用于DEBUG）
# ==========================================
def trace_normalize_fuzzy(value):
    """逐步展示 fuzzy 规范化的全过程"""
    steps = []
    
    if pd.isna(value):
        return None, [("输入", "NaN/None")]
    
    original = str(value)
    steps.append(("0. 原始输入", original))
    
    # 步骤1：移除隐藏字符
    s = original.replace("\x00", "").replace("\ufeff", "")
    steps.append(("1. 移除隐藏字符", s))
    
    # 步骤2：Unicode标准化
    text = unicodedata.normalize("NFKC", s).strip().lower()
    steps.append(("2. Unicode标准化+小写", text))
    
    # 步骤3：移除非中英数字符
    text_before_regex = text
    text = re.sub(r"[^\w\u4e00-\u9fff]", "", text)
    steps.append((f"3. 移除非中英数 (regex替换)", f"{text_before_regex} → {text}"))
    
    # 步骤4：逐个删除后缀
    suffixes = ["有限责任公司", "股份有限公司", "有限公司", "责任公司", "分公司", "公司", "中国", "上海分行", "分行"]
    for sfx in suffixes:
        text_before = text
        text = text.replace(sfx, "")
        if text != text_before:
            steps.append((f"4. 删除后缀'{sfx}'", f"{text_before} → {text}"))
    
    # 步骤5：返回判断
    result = text if text else None
    if result is None:
        steps.append(("5. 最终返回", f"None (因为处理后为空字符串)"))
    else:
        steps.append(("5. 最终返回", result))
    
    return result, steps

def trace_normalize_strict(value):
    """逐步展示 strict 规范化的全过程"""
    steps = []
    
    if pd.isna(value):
        return None, [("输入", "NaN/None")]
    
    original = str(value)
    steps.append(("0. 原始输入", original))
    
    s = original.replace("\x00", "").replace("\ufeff", "")
    steps.append(("1. 移除隐藏字符", s))
    
    text = unicodedata.normalize("NFKC", s).strip()
    steps.append(("2. Unicode标准化+strip", text))
    
    text = re.sub(r"[\u200B-\u200D\uFEFF\u00A0]", "", text)
    steps.append(("3. 移除零宽字符", text))
    
    text = re.sub(r"\s+", "", text).lower()
    steps.append(("4. 移除空格+小写", text))
    
    text = text.replace("（", "(").replace("）", ")")
    steps.append(("5. 替换中文括号→英文括号", text))
    
    text = re.sub(r"[^0-9a-zA-Z\u4e00-\u9fff\(\)\-\,\.\u00b7]", "", text)
    steps.append(("6. 保留允许的字符", text))
    
    result = text if text else None
    steps.append(("7. 最终返回", result))
    
    return result, steps

def trace_to_cents(value):
    """逐步展示金额转换的全过程"""
    steps = []
    
    original = value
    steps.append(("0. 原始输入", f"{original} (类型: {type(original).__name__})"))
    
    if pd.isna(value):
        steps.append(("判定", "NaN/None → 返回 None"))
        return None, steps
    
    if isinstance(value, (float, np.floating)):
        if np.isnan(value) or np.isinf(value):
            steps.append(("判定", "NaN/Inf → 返回 None"))
            return None, steps
        num_str = f"{value:.2f}"
        steps.append(("转换", f"float转2位小数字符串: {num_str}"))
        
    elif isinstance(value, (int, np.integer)):
        num_str = str(value)
        steps.append(("转换", f"int转字符串: {num_str}"))
        
    else:
        s = unicodedata.normalize("NFKC", str(value)).strip()
        steps.append(("1. Unicode标准化", s))
        
        if not s:
            steps.append(("判定", "空字符串 → 返回 None"))
            return None, steps
        
        s = s.replace("\x00", "").replace("\ufeff", "").replace(",", "")
        steps.append(("2. 移除隐藏字符和逗号", s))
        
        s = s.replace("￥", "").replace("$", "").replace("¥", "").replace("CNY", "")
        steps.append(("3. 移除货币符号", s))
        
        s = s.replace("．", ".").replace("。", ".")
        steps.append(("4. 替换特殊小数点", s))
        
        if s.startswith("(") and s.endswith(")"):
            s = "-" + s[1:-1]
            steps.append(("5. 括号→负号", s))
        
        m = re.search(r"[-]?\d+(\.\d+)?([eE][+-]?\d+)?", s)
        if not m:
            steps.append(("判定", "未找到有效数字 → 返回 None"))
            return None, steps
        num_str = m.group(0)
        steps.append(("6. 提取数字", num_str))
    
    try:
        amt = Decimal(num_str).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
        cents = int(amt * 100)
        steps.append(("7. Decimal转换", f"{num_str} → {amt} 元 → {cents} 分"))
        return cents, steps
    except Exception as e:
        steps.append(("错误", f"Decimal转换失败: {str(e)}"))
        return None, steps

