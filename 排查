# 6. Key 匹配分析
# ==========================================
print(f"\n\n【KEY匹配分析】\n")

prop_strict_keys = set(df_prop["Buyer Name (Local)"].apply(normalize_name_strict).dropna().unique())
pay_strict_keys = set(df_pay["Client_Name"].apply(normalize_name_strict).dropna().unique())
strict_overlap = prop_strict_keys.intersection(pay_strict_keys)

prop_fuzzy_keys = set(df_prop["Buyer Name (Local)"].apply(normalize_name_fuzzy).dropna().unique())
pay_fuzzy_keys = set(df_pay["Client_Name"].apply(normalize_name_fuzzy).dropna().unique())
fuzzy_overlap = prop_fuzzy_keys.intersection(pay_fuzzy_keys)

prop_agg_keys = set(df_prop["Buyer Name (Local)"].apply(normalize_name_aggressive).dropna().unique())
pay_agg_keys = set(df_pay["Client_Name"].apply(normalize_name_aggressive).dropna().unique())
