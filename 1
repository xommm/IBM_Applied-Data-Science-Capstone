@echo off
setlocal

set "folder=%~dp0"
echo Using folder: "%folder%"
echo Listing xls files...

powershell -NoProfile -Command ^
" $folder = '%folder%'; " ^
"+ Get-ChildItem -Path $folder -Filter '*.xls' | Select-Object -First 5 FullName | ForEach-Object { $_.ToString() }; " ^
"+ Get-ChildItem -Path $folder -Filter '*.xls' | Measure-Object | ForEach-Object { 'Count=' + $_.Count } ; "

pause
