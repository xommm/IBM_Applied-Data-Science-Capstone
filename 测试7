# 1. 辅助函数（客户名 strict key + 金额转分）
# ==========================================
def normalize_name_strict(value):
    """深度规格化客户名称：去除所有 Unicode 隐藏字符、全半角空格、统一半角括号并小写。"""
    if pd.isna(value):
        return None
    s = str(value).replace("\x00", "").replace("\ufeff", "")
    text = unicodedata.normalize("NFKC", s).strip()
    if not text:
        return None
    # 去除所有零宽字符和各类空格 (\s, \xa0 等)
    text = re.sub(r"[\u200B-\u200D\uFEFF\u00A0]", "", text)
    text = re.sub(r"\s+", "", text)
    text = text.lower()
    text = text.replace("（", "(").replace("）", ")")
    text = re.sub(r"[^0-9a-zA-Z\u4e00-\u9fff\(\)\-\,\.\u00b7]", "", text)
    return text if text else None


def to_cents(value):
    """将各类格式（Float/FixedDecimal/String/千分位/货币符号）准确转为整数“分”。"""
    if pd.isna(value):
        return None

    if isinstance(value, (float, np.floating)):
        if np.isnan(value) or np.isinf(value):
            return None
        num_str = f"{value:.2f}"
    elif isinstance(value, (int, np.integer)):
        num_str = str(value)
    else:
        s = unicodedata.normalize("NFKC", str(value)).strip()
        if not s:
            return None
        # 清理千分位逗号及货币符号
        s = s.replace("\x00", "").replace("\ufeff", "").replace(",", "")
        s = s.replace("￥", "").replace("$", "").replace("¥", "").replace("CNY", "")
        s = s.replace("．", ".").replace("。", ".")

        if s.startswith("(") and s.endswith(")"):
            s = "-" + s[1:-1]

        m = re.search(r"[-]?\d+(\.\d+)?([eE][+-]?\d+)?", s)
        if not m:
            return None
        num_str = m.group(0)

    try:
        amt = Decimal(num_str).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
        return int(amt * 100)
    except Exception:
        return None


def format_money_from_cents(cents):
    """将整数“分”格式化回保留两位小数的字符串金额。"""
    if cents is None:
        return None
    return f"{Decimal(int(cents)) / Decimal(100):.2f}"


def format_unique_field(record_list, field_name):
    """提取多条记录中的唯一非空字段值，以逗号分隔拼接。"""
    valid_values = []
    seen = set()
    for record in record_list:
        value = record.get(field_name)
        if pd.isna(value) or value is None:
            continue
        string_value = str(value).strip()
        if not string_value or string_value in seen:
            continue
        valid_values.append(string_value)
        seen.add(string_value)
    return ", ".join(valid_values) if valid_values else None


# ==========================================
# 2. 子集搜索：支持 min_items 与 ±1分钱 尾差容错
# ==========================================
def find_best_subset(records, target, max_items, min_items=1, tolerance=TOLERANCE_CENTS):
    """在 records 中寻找金额合计约等于 target 的组合（支持 ±tolerance 分尾差容错）。"""

    if target < 0:
        return None

    positive_records = [r for r in records if r["amount"] > 0]
    zero_records = [r for r in records if r["amount"] == 0]

    # target == 0 特殊处理
    if target == 0:
        if min_items <= 1:
            return [zero_records[0]] if zero_records else None
        if len(zero_records) >= min_items:
            return zero_records[:min_items]
        return None

    sorted_records = sorted(positive_records, key=lambda r: (-r["amount"], r["row_id"]))
    record_count = len(sorted_records)
    if record_count == 0:
        return None

    max_items = min(max_items, record_count)
    if min_items > max_items:
        return None

    for required_count in range(min_items, max_items + 1):
        result = None

        def dfs(start_index, remaining, current_subset):
            nonlocal result
            if result is not None:
                return

            selected_count = len(current_subset)
            slots_left = required_count - selected_count

            if slots_left == 0:
                # 容许 ±tolerance 分钱误差
                if -tolerance <= remaining <= tolerance:
                    result = list(current_subset)
                return

            if record_count - start_index < slots_left:
                return
            if remaining < -tolerance:
                return

            max_possible = sum(sorted_records[i]["amount"] for i in range(start_index, start_index + slots_left))
            min_possible = sum(sorted_records[i]["amount"] for i in range(record_count - slots_left, record_count))

            if remaining > max_possible + tolerance or remaining < min_possible - tolerance:
                return

            last_amount = None
            for index in range(start_index, record_count - slots_left + 1):
                record = sorted_records[index]
                amount = record["amount"]

                if last_amount is not None and amount == last_amount:
                    continue
                last_amount = amount

                if amount > remaining + tolerance:
                    continue

                current_subset.append(record)
                dfs(index + 1, remaining - amount, current_subset)
                current_subset.pop()

                if result is not None:
                    return

        dfs(0, target, [])
        if result is not None:
            return result

    return None


