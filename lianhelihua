from ayx import Package
from ayx import Alteryx
import pandas as pd
from decimal import Decimal, ROUND_HALF_UP
import re
import unicodedata
import numpy as np

# ==========================================
# 绝密单公司测试版：仅针对“联合利华”
# ==========================================

# 1. 读取输入
df_proposal_raw = Alteryx.read("#1")
df_payment_raw = Alteryx.read("#2")

df_proposal_raw.columns = [str(c).strip() for c in df_proposal_raw.columns]
df_payment_raw.columns = [str(c).strip() for c in df_payment_raw.columns]

df_proposal = df_proposal_raw.copy()
df_payment = df_payment_raw.copy()

# 自动补齐主键
if "proposal_key" not in df_proposal.columns or df_proposal["proposal_key"].isna().all():
    df_proposal["proposal_key"] = df_proposal.get("Record", range(1, len(df_proposal) + 1))
if "payment_key" not in df_payment.columns or df_payment["payment_key"].isna().all():
    df_payment["payment_key"] = df_payment.get("Record", range(1, len(df_payment) + 1))

# ==========================================
# 🎯 核心暴力过滤：只抓取联合利华的所有行！
# 哪怕 Buyer Name 是 Null，只要 Internal Buyer Reference 是 CN01 也全部强制抓取！
# ==========================================
def is_unilever_prop(row):
    name = str(row.get("Buyer Name (Local)", "")).strip()
    ref = str(row.get("Internal Buyer Reference", "")).strip()
    return ("联合利华" in name) or (ref == "CN01")

def is_unilever_pay(row):
    name = str(row.get("Client_Name", "")).strip()
    return "联合利华" in name

df_proposal["_is_unilever"] = df_proposal.apply(is_unilever_prop, axis=1)
df_payment["_is_unilever"] = df_payment.apply(is_unilever_pay, axis=1)

df_prop_uni = df_proposal[df_proposal["_is_unilever"]].copy()
df_pay_uni = df_payment[df_payment["_is_unilever"]].copy()

# ==========================================
# 金额转换
# ==========================================
def to_cents(value):
    if pd.isna(value): return None
    if isinstance(value, (float, np.floating)):
        if np.isnan(value) or np.isinf(value): return None
        num_str = f"{value:.2f}"
    elif isinstance(value, (int, np.integer)):
        num_str = str(value)
    else:
        s = str(value).replace(",", "").replace("$", "").replace("¥", "").replace("￥", "").strip()
        m = re.search(r"[-]?\d+(\.\d+)?([eE][+-]?\d+)?", s)
        if not m: return None
        num_str = m.group(0)
    try:
        amt = Decimal(num_str).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
        return int(amt * 100)
    except:
        return None

df_prop_uni["_amount_cents"] = df_prop_uni["Proposal Total Amount"].apply(to_cents)
df_pay_uni["_amount_cents"] = df_pay_uni["Yesterday_Balance"].apply(to_cents)

prop_records = df_prop_uni.dropna(subset=["_amount_cents"]).to_dict("records")
pay_records = df_pay_uni.dropna(subset=["_amount_cents"]).to_dict("records")

available_proposals = [{"row_id": i, "id": r["proposal_key"], "amount": int(r["_amount_cents"])} for i, r in enumerate(prop_records)]
available_payments = [{"row_id": i, "id": r["payment_key"], "amount": int(r["_amount_cents"]), "Debit Account": r.get("Debit Account"), "Debtor_Agent_Name": r.get("Debtor_Agent_Name"), "Debtor Agent Party ID": r.get("Debtor Agent Party ID")} for i, r in enumerate(pay_records)]

print("=== 联合利华专项暴力测试 ===")
print(f"抓取到的 Proposal 笔数: {len(available_proposals)}")
print(f"抓取到的 Payment 笔数: {len(available_payments)}")

total_prop_cents = sum(p["amount"] for p in available_proposals)
print(f"所有 Proposal 总金额 (分): {total_prop_cents}")
if available_payments:
    print(f"Payment 单笔金额 (分): {available_payments[0]['amount']}")

match_results = {}
matched_pay_ids = set()

# 暴力全额匹配
if available_payments and total_prop_cents == available_payments[0]["amount"]:
    print("✅ 暴力全额匹配成功！总额完全相等！")
    pay_item = available_payments[0]
    prop_ids_str = ", ".join(str(p["id"]) for p in available_proposals)
    
    match_info = {
        "Matched_Payment_IDs": str(pay_item["id"]),
        "Matched_Payment_Amounts": f"{Decimal(pay_item['amount'])/Decimal(100):.2f}",
        "Matched_Debit_Account": pay_item.get("Debit Account"),
        "Matched_Debtor_Agent_Name": pay_item.get("Debtor_Agent_Name"),
        "Matched_Debtor_Agent_Party_ID": pay_item.get("Debtor Agent Party ID"),
        "Group_Matched_Proposals": prop_ids_str,
        "Group_Target_Sum": float(Decimal(pay_item["amount"]) / Decimal(100)),
        "Match_Type": "Many-Proposals-to-One-Payment",
        "Matched_Proposal_Count": len(available_proposals),
        "Matched_Payment_Count": 1
    }
    for p in available_proposals:
        match_results[p["row_id"]] = match_info
    matched_pay_ids.add(pay_item["row_id"])
else:
    print("❌ 匹配失败！金额不相等！")

# 回填
result_columns = [
    "Matched_Payment_IDs", "Matched_Payment_Amounts", "Matched_Debit_Account",
    "Matched_Debtor_Agent_Name", "Matched_Debtor_Agent_Party_ID", "Group_Matched_Proposals",
    "Group_Target_Sum", "Match_Type", "Matched_Proposal_Count", "Matched_Payment_Count"
]

for col in result_columns:
    df_prop_uni[col] = [match_results.get(i, {}).get(col) for i in range(len(df_prop_uni))]

df_unmatched_pay = df_pay_uni.copy()

# 删除辅助列
df_prop_uni = df_prop_uni.drop(columns=["_is_unilever", "_amount_cents"])
df_unmatched_pay = df_unmatched_pay.drop(columns=["_is_unilever", "_amount_cents"])

Alteryx.write(df_prop_uni, 1)
Alteryx.write(df_unmatched_pay, 2)
