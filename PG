from ayx import Alteryx
import pandas as pd
import numpy as np
from itertools import combinations

# 1. 读取输入数据
# 请确保输入 1 连接至 Anchor #1，输入 2 连接至 Anchor #2
df1 = Alteryx.read("#1")
df2 = Alteryx.read("#2")

# 2. 数据预处理（转换金额列为数值型，防止字符串影响计算）
df1['Proposal Total Amount'] = pd.to_numeric(df1['Proposal Total Amount'], errors='coerce').fillna(0)
df2['Payment Net Amount'] = pd.to_numeric(df2['Payment Net Amount'], errors='coerce').fillna(0)

# 初始化目标字段
df1['Payment Group Reference'] = None

# 定义子集组合求和匹配函数 (1个Payment金额 对 多个Proposal金额)
def find_subset_match(proposal_items, target_amount, tolerance=0.01):
    """
    proposal_items: [(df1_index, amount), ...]
    target_amount: 目标 Payment 金额
    tolerance: 容差范围（用于处理浮点数精度误差）
    """
    n = len(proposal_items)
    # 限制组合元素个数最大为 10，防止暴搜耗时过长（可调整）
    max_comb_length = min(n, 10) 
    
    for r in range(2, max_comb_length + 1):
        for combo in combinations(proposal_items, r):
            combo_sum = sum(item[1] for item in combo)
            if abs(combo_sum - target_amount) <= tolerance:
                return [item[0] for item in combo] # 返回匹配到的 df1 索引列表
    return None

# 3. 按 Internal Buyer Reference 分组处理匹配逻辑
for ref, group1 in df1.groupby('Internal Buyer Reference'):
    if pd.isna(ref) or str(ref).strip() == '':
        continue
        
    group1_indices = group1.index.tolist()
    group2 = df2[df2['Internal Buyer Reference'] == ref]
    
    # 场景 A: 输入 2 中未找到匹配的 Reference
    if group2.empty:
        continue
        
    # 场景 B: 仅找到唯一一条 Payment 记录（无歧义，直接映射）
    if len(group2) == 1:
        pay_ref = group2.iloc[0]['Payment Group Reference']
        df1.loc[group1_indices, 'Payment Group Reference'] = pay_ref
        continue
        
    # 场景 C: 存在多条 Payment 记录（存在冲突/多 Drawee 情况），启动金额匹配机制
    unmatched_df1 = group1.copy()
    unmatched_df2 = group2.copy()
    
    # ---------------- 步骤 C1: 1v1 金额匹配 ----------------
    matched_df2_indices = []
    for idx2, row2 in unmatched_df2.iterrows():
        target_amt = row2['Payment Net Amount']
        pay_ref = row2['Payment Group Reference']
        
        # 查找 Proposal 中金额完全相等的行
        matches_1v1 = unmatched_df1[np.isclose(unmatched_df1['Proposal Total Amount'], target_amt, atol=0.01)]
        if not matches_1v1.empty:
            matched_idx1 = matches_1v1.index[0] # 取第1个匹配项
            df1.loc[matched_idx1, 'Payment Group Reference'] = pay_ref
            
            # 从待匹配池中移除已匹配项
            unmatched_df1 = unmatched_df1.drop(matched_idx1)
            matched_df2_indices.append(idx2)
            
    unmatched_df2 = unmatched_df2.drop(matched_df2_indices)
    
    # ---------------- 步骤 C2: 1对多（1个 Payment 对 多个 Proposal）组合匹配 ----------------
    for idx2, row2 in unmatched_df2.iterrows():
        if unmatched_df1.empty:
            break
            
        target_amt = row2['Payment Net Amount']
        pay_ref = row2['Payment Group Reference']
        
        # 准备剩余 Proposal 的 (索引, 金额) 列表
        proposal_items = [(idx1, row1['Proposal Total Amount']) for idx1, row1 in unmatched_df1.iterrows() if row1['Proposal Total Amount'] > 0]
        
        # 计算组合求和
        matched_indices = find_subset_match(proposal_items, target_amt)
        if matched_indices:
            # 将匹配到的所有 Proposal 全部追加同一个 Payment Group Reference
            df1.loc[matched_indices, 'Payment Group Reference'] = pay_ref
            # 从待匹配池中移除
            unmatched_df1 = unmatched_df1.drop(matched_indices)

# 4. 写出结果到 Alteryx 输出端口 1
Alteryx.write(df1, 1)
