import pandas as pd
import numpy as np

df1 = Alteryx.read("#1").to_dataframe()  # 完整信息表
df2 = Alteryx.read("#2").to_dataframe()  # Paymentgroup表

# -------------------------
# 字段名（按你提供的）
# -------------------------
col1_ibr = "Internal Buyer Reference"
col1_amt = "Proposal Total Amount"
col1_drawee = "Buyer Name (Local)"  # Input1里的 Drawee 名称

col2_pgr = "Payment Group Reference"
col2_amt = "Payment Net Amount"
col2_drawee = "Drawee (Local)"      # 如果 Input2 也叫 Buyer Name (Local)，把这一行改掉
col2_ibr = "Internal Buyer Reference"

out_col = "Payment Group Reference"

# -------------------------
# 金额标准化
# -------------------------
df1["_amt"] = pd.to_numeric(df1[col1_amt], errors="coerce")
df2["_amt"] = pd.to_numeric(df2[col2_amt], errors="coerce")

ROUND_DECIMALS = 2
df1["_amt_r"] = df1["_amt"].round(ROUND_DECIMALS)
df2["_amt_r"] = df2["_amt"].round(ROUND_DECIMALS)

# -------------------------
# 初始化输出列
# -------------------------
df1[out_col] = np.nan

# -------------------------
# 构建映射：先 (IBR, Drawee, Amount)；再兜底 (IBR, Amount)
# -------------------------
# 主映射： (IBR, Drawee, Amount) -> PGR
sub2_main = (
    df2.dropna(subset=[col2_ibr, col2_drawee, col2_pgr])
       .groupby([col2_ibr, col2_drawee, "_amt_r"])[col2_pgr]
       .first()
       .reset_index()
)

main_dict = {
    (row[col2_ibr], row[col2_drawee], row["_amt_r"]): row[col2_pgr]
    for _, row in sub2_main.iterrows()
}

# 兜底映射： (IBR, Amount) -> PGR
sub2_fallback = (
    df2.dropna(subset=[col2_ibr, col2_pgr])
       .groupby([col2_ibr, "_amt_r"])[col2_pgr]
       .first()
       .reset_index()
)

fallback_dict = {
    (row[col2_ibr], row["_amt_r"]): row[col2_pgr]
    for _, row in sub2_fallback.iterrows()
}

# -------------------------
# 逐行赋值（只给还未赋值的行）
# -------------------------
mask_unassigned = df1[out_col].isna()
idxs = df1.index[mask_unassigned].tolist()

for idx in idxs:
    ibr = df1.at[idx, col1_ibr]
    drawee_val = df1.at[idx, col1_drawee]
    amt_r = df1.at[idx, "_amt_r"]

    key_main = (ibr, drawee_val, amt_r)
    if key_main in main_dict:
        df1.at[idx, out_col] = main_dict[key_main]
    else:
        key_fallback = (ibr, amt_r)
        if key_fallback in fallback_dict:
            df1.at[idx, out_col] = fallback_dict[key_fallback]

# -------------------------
# 清理临时列 + 输出
# -------------------------
df1 = df1.drop(columns=["_amt", "_amt_r"], errors="ignore")
Output = df1
