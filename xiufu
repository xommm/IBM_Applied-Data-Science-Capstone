def normalize_name_strict(value):
    if pd.isna(value):
        return None
    s = str(value).replace("\x00", "").replace("\ufeff", "")
    text = unicodedata.normalize("NFKC", s).strip()
    if not text:
        return None
    text = re.sub(r"[\u200B-\u200D\uFEFF\u00A0]", "", text)
    text = re.sub(r"\s+", "", text).lower()
    text = text.replace("（", "(").replace("）", ")")
    text = re.sub(r"[^0-9a-zA-Z\u4e00-\u9fff\(\)\-\,\.\u00b7]", "", text)
    return text if text else None


def normalize_name_fuzzy(value):
    if pd.isna(value):
        return None
    s = str(value).replace("\x00", "").replace("\ufeff", "")
    text = unicodedata.normalize("NFKC", s).strip().lower()
    if not text:
        return None
    text = re.sub(r"[^\w\u4e00-\u9fff]", "", text)

    suffixes = [
        "有限责任公司", "股份有限公司", "有限公司", "责任公司",
        "分公司", "公司", "中国", "上海分行", "分行"
    ]
    for sfx in suffixes:
        text = text.replace(sfx, "")

    return text if text else None


def normalize_name_aggressive(value):
    if pd.isna(value):
        return None
    s = str(value).replace("\x00", "").replace("\ufeff", "")
    text = unicodedata.normalize("NFKC", s).strip().lower()
    text = re.sub(r"[^0-9a-zA-Z\u4e00-\u9fff]", "", text)
    return text if text else None


def to_cents(value):
    if pd.isna(value):
        return None

    if isinstance(value, (float, np.floating)):
        if np.isnan(value) or np.isinf(value):
            return None
        num_str = f"{value:.2f}"
    elif isinstance(value, (int, np.integer)):
        num_str = str(value)
    else:
        s = unicodedata.normalize("NFKC", str(value)).strip()
        if not s:
            return None

        s = s.replace("\x00", "").replace("\ufeff", "").replace(",", "")
        s = s.replace("￥", "").replace("$", "").replace("¥", "").replace("CNY", "")
        s = s.replace("．", ".").replace("。", ".")

        if s.startswith("(") and s.endswith(")"):
            s = "-" + s[1:-1]

        m = re.search(r"[-]?\d+(\.\d+)?([eE][+-]?\d+)?", s)
        if not m:
            return None
        num_str = m.group(0)

    try:
        amt = Decimal(num_str).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
        return int(amt * 100)
    except Exception:
        return None


def format_money_from_cents(cents):
    if cents is None:
        return None
    return f"{Decimal(int(cents)) / Decimal(100):.2f}"


def format_unique_field(record_list, field_name):
    valid_values = []
    seen = set()
    for record in record_list:
        value = record.get(field_name)
        if pd.isna(value):
            continue
        string_value = str(value).strip()
        if not string_value or string_value in seen:
            continue
        valid_values.append(string_value)
        seen.add(string_value)
    return ", ".join(valid_values) if valid_values else None


# ==========================================
# 2. 优化版子集搜索（含反向补集加速算法）
# ==========================================
def find_best_subset(records, target, max_items, min_items=1):
    """
    在 records 中寻找金额合计等于 target 的组合（整数分精确匹配）。
    优化点：增加了【补集反向搜索】，极速解决 11 选 10、20 选 19 等大组合场景。
    """
    if target < 0 or not records:
        return None

    positive_records = [r for r in records if r["amount"] > 0]
    zero_records = [r for r in records if r["amount"] == 0]

    # target == 0 特殊情况处理
    if target == 0:
        if min_items <= 1:
            return [zero_records[0]] if zero_records else None
        if len(zero_records) >= min_items:
            return zero_records[:min_items]
        return None

    total_pos_sum = sum(r["amount"] for r in positive_records)
    n = len(positive_records)

    if n == 0 or target > total_pos_sum:
        return None

    # 1. 恰好全选
    if target == total_pos_sum and min_items <= n <= max_items:
        return positive_records

    # 2. 补集反向搜索（当目标金额接近总额，即只需要剔除 1~5 笔单据时触发）
    remainder = total_pos_sum - target
    if remainder > 0:
        exclude_count_max = n - min_items
        if 1 <= exclude_count_max <= 5:
            for ex_cnt in range(1, exclude_count_max + 1):
                for combo in combinations(positive_records, ex_cnt):
                    if sum(r["amount"] for r in combo) == remainder:
                        selected_subset = [r for r in positive_records if r not in combo]
                        if min_items <= len(selected_subset) <= max_items:
                            return selected_subset

    # 3. 标准正向 DFS 递归搜索
    sorted_records = sorted(positive_records, key=lambda r: (-r["amount"], r["row_id"]))
    max_items = min(max_items, n)
    if min_items > max_items:
        return None

    for required_count in range(min_items, max_items + 1):
        result = None

        def dfs(start_index, remaining, current_subset):
            nonlocal result
            if result is not None:
                return

            slots_left = required_count - len(current_subset)
            if slots_left == 0:
                if remaining == 0:
                    result = list(current_subset)
                return

            if n - start_index < slots_left or remaining < 0:
                return

            max_possible = sum(sorted_records[i]["amount"] for i in range(start_index, start_index + slots_left))
            min_possible = sum(sorted_records[i]["amount"] for i in range(n - slots_left, n))

            if remaining > max_possible or remaining < min_possible:
                return

            last_amount = None
            for index in range(start_index, n - slots_left + 1):
                record = sorted_records[index]
                amt = record["amount"]

                if last_amount is not None and amt == last_amount:
                    continue
                last_amount = amt

                if amt > remaining:
                    continue

                current_subset.append(record)
                dfs(index + 1, remaining - amt, current_subset)
                current_subset.pop()

                if result is not None:
                    return

        dfs(0, target, [])
        if result is not None:
            return result

    return None


