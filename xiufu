match_results = {}
matched_payment_row_ids = set()


def save_match(proposal_records, payment_records):
    proposal_count = len(proposal_records)
    payment_count = len(payment_records)

    if proposal_count == 1 and payment_count == 1:
        match_type = "One-to-One"
    elif proposal_count > 1 and payment_count == 1:
        match_type = "Many-Proposals-to-One-Payment"
    elif proposal_count == 1 and payment_count > 1:
        match_type = "One-Proposal-to-Many-Payments"
    else:
        match_type = "Many-to-Many"

    target_cents = sum(p["amount"] for p in proposal_records)

    payment_ids_string = ", ".join(str(p["id"]) for p in payment_records)
    payment_amounts_string = ", ".join(format_money_from_cents(p["amount"]) for p in payment_records)
    proposal_ids_string = ", ".join(str(pr["id"]) for pr in proposal_records)

    debit_account_string = format_unique_field(payment_records, "Debit Account")
    debtor_agent_name_string = format_unique_field(payment_records, "Debtor_Agent_Name")
    debtor_agent_party_id_string = format_unique_field(payment_records, "Debtor Agent Party ID")

    result = {
        "Matched_Payment_IDs": payment_ids_string,
        "Matched_Payment_Amounts": payment_amounts_string,
        "Matched_Debit_Account": debit_account_string,
        "Matched_Debtor_Agent_Name": debtor_agent_name_string,
        "Matched_Debtor_Agent_Party_ID": debtor_agent_party_id_string,
        "Group_Matched_Proposals": proposal_ids_string if proposal_count > 1 else None,
        "Group_Target_Sum": round(target_cents / 100.0, 2) if proposal_count > 1 else None,
        "Match_Type": match_type,
        "Matched_Proposal_Count": proposal_count,
        "Matched_Payment_Count": payment_count
    }

    for proposal in proposal_records:
        match_results[proposal["row_id"]] = result.copy()

    for payment in payment_records:
        matched_payment_row_ids.add(payment["row_id"])


# ==========================================
# 6. 核心匹配引擎
# ==========================================
def run_matching_engine(prop_df, pay_df, key_column):
    for client_key, proposal_group in prop_df.groupby(key_column, sort=False):
        if pd.isna(client_key) or str(client_key).strip() == "":
            continue

        payment_group = pay_df[pay_df[key_column] == client_key]

        unmatched_proposals = proposal_group[~proposal_group["_proposal_row_id"].isin(match_results.keys())]
        unmatched_payments = payment_group[~payment_group["_payment_row_id"].isin(matched_payment_row_ids)]

        if unmatched_proposals.empty or unmatched_payments.empty:
            continue

        available_proposals = []
        for _, row in unmatched_proposals.iterrows():
            available_proposals.append({
                "row_id": int(row["_proposal_row_id"]),
                "id": row["proposal_key"],
                "amount": int(row["_amount_cents"])
            })

        available_payments = []
        for _, row in unmatched_payments.iterrows():
            available_payments.append({
                "row_id": int(row["_payment_row_id"]),
                "id": row["payment_key"],
                "amount": int(row["_amount_cents"]),
                "Debit Account": row["Debit Account"],
                "Debtor_Agent_Name": row["Debtor_Agent_Name"],
                "Debtor Agent Party ID": row["Debtor Agent Party ID"]
            })

        available_proposals.sort(key=lambda r: (-r["amount"], r["row_id"]))
        available_payments.sort(key=lambda r: (-r["amount"], r["row_id"]))

        # ---------------- 阶段 0：全额直通车 ----------------
        total_proposal_sum = sum(p["amount"] for p in available_proposals)
        for payment in list(available_payments):
            if payment["amount"] == total_proposal_sum and len(available_proposals) >= 1:
                save_match(available_proposals, [payment])
                available_proposals = []
                available_payments = [pay for pay in available_payments if pay["row_id"] != payment["row_id"]]
                break

        if not available_proposals or not available_payments:
            continue

        # ---------------- 阶段 1：一笔 Payment 对应多笔 Proposal (多对一，>=2笔) ----------------
        progress = True
        while progress and available_proposals and available_payments:
            progress = False
            for payment in list(available_payments):
                proposal_subset = find_best_subset(
                    available_proposals,
                    payment["amount"],
                    MAX_PROPOSALS_PER_MATCH,
                    min_items=2
                )
                if not proposal_subset:
                    continue

                save_match(proposal_subset, [payment])

                used_proposal_rows = {p["row_id"] for p in proposal_subset}
                available_proposals = [p for p in available_proposals if p["row_id"] not in used_proposal_rows]
                available_payments = [pay for pay in available_payments if pay["row_id"] != payment["row_id"]]

                progress = True
                break

        if not available_proposals or not available_payments:
            continue

        # ---------------- 阶段 2：同金额一对一匹配 ----------------
        progress = True
        while progress and available_proposals and available_payments:
            progress = False

            payment_by_amount = {}
            for pay in available_payments:
                payment_by_amount.setdefault(pay["amount"], []).append(pay)

            for proposal in list(available_proposals):
                if proposal["amount"] not in payment_by_amount:
                    continue
                matched_payment = payment_by_amount[proposal["amount"]][0]

                save_match([proposal], [matched_payment])

                available_proposals = [p for p in available_proposals if p["row_id"] != proposal["row_id"]]
                available_payments = [pay for pay in available_payments if pay["row_id"] != matched_payment["row_id"]]
                progress = True
                break

        if not available_proposals or not available_payments:
            continue

        # ---------------- 阶段 3：一笔 Proposal 对应多笔 Payment (一对多，>=2笔) ----------------
        progress = True
        while progress and available_proposals and available_payments:
            progress = False
            for proposal in list(available_proposals):
                payment_subset = find_best_subset(
                    available_payments,
                    proposal["amount"],
                    MAX_PAYMENTS_PER_MATCH,
                    min_items=2
                )
                if not payment_subset:
                    continue

                save_match([proposal], payment_subset)

                available_proposals = [p for p in available_proposals if p["row_id"] != proposal["row_id"]]
                used_payment_rows = {pay["row_id"] for pay in payment_subset}
                available_payments = [pay for pay in available_payments if pay["row_id"] not in used_payment_rows]

                progress = True
                break

        if not available_proposals or not available_payments:
            continue

        # ---------------- 阶段 4：多 Proposal 对多 Payment (多对多，双方均>=2笔) ----------------
        progress = True
        while progress and available_proposals and available_payments:
            progress = False
            maximum_proposal_count = min(MAX_PROPOSALS_PER_MATCH, len(available_proposals))

            for proposal_count in range(2, maximum_proposal_count + 1):
                matched_at_this_level = False

                for proposal_combo in combinations(available_proposals, proposal_count):
                    target_cents = sum(p["amount"] for p in proposal_combo)

                    payment_subset = find_best_subset(
                        available_payments,
                        target_cents,
                        MAX_PAYMENTS_PER_MATCH,
                        min_items=2
                    )
                    if not payment_subset:
                        continue

                    save_match(list(proposal_combo), payment_subset)

                    used_proposal_rows = {p["row_id"] for p in proposal_combo}
                    used_payment_rows = {pay["row_id"] for pay in payment_subset}

                    available_proposals = [p for p in available_proposals if p["row_id"] not in used_proposal_rows]
                    available_payments = [pay for pay in available_payments if pay["row_id"] not in used_payment_rows]

                    progress = True
                    matched_at_this_level = True
                    break

                if matched_at_this_level:
                    break


