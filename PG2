from ayx import Alteryx
import pandas as pd
import numpy as np
from itertools import combinations

# 1. 读取输入数据
# Anchor #1 -> Payment 数据（含 Drawee (Local), Payment Net Amount, Payment Group Reference）
# Anchor #2 -> Proposal 数据（含 First_Buyer Name (Local) / Internal Buyer Reference, Proposal Total Amount）
df_payment = Alteryx.read("#1")
df_proposal = Alteryx.read("#2")

# 2. 文本清洗函数（自动解决中英文全半角括号及空格不一致问题）
def clean_text(val):
    if pd.isna(val):
        return ""
    s = str(val).strip()
    s = s.replace("（", "(").replace("）", ")")
    return " ".join(s.split())

# ----------------- 智能匹配列名 -----------------
def get_col(df, candidates):
    for c in candidates:
        if c in df.columns:
            return c
    for c in candidates:
        for col in df.columns:
            if c.lower() in str(col).lower():
                return col
    return candidates[0]

col_pay_key = get_col(df_payment, ['Drawee (Local)', 'Drawee', 'Buyer Name (Local)', 'Internal Buyer Reference'])
col_pay_amt = get_col(df_payment, ['Payment Net Amount', 'Sum_Payment Net Amount', 'Net Amount', 'Amount'])
col_pay_ref = get_col(df_payment, ['Payment Group Reference', 'Payment Reference', 'Reference'])

col_prop_key = get_col(df_proposal, ['First_Buyer Name (Local)', 'Buyer Name (Local)', 'Internal Buyer Reference', 'Buyer Name'])
col_prop_amt = get_col(df_proposal, ['Sum_Proposal Total Amount', 'Proposal Total Amount', 'Total Amount', 'Amount'])

# 生成清洗后的对比 Key
df_payment['Clean_Key'] = df_payment[col_pay_key].apply(clean_text)
df_proposal['Clean_Key'] = df_proposal[col_prop_key].apply(clean_text)

# 转换金额为浮点数
df_payment['_AMT'] = pd.to_numeric(df_payment[col_pay_amt], errors='coerce').fillna(0.0)
df_proposal['_AMT'] = pd.to_numeric(df_proposal[col_prop_amt], errors='coerce').fillna(0.0)

# 在 Proposal 表中初始化目标字段
df_proposal['Payment Group Reference'] = None

# 子集求和函数
def find_subset_match(items, target_amount, tolerance=0.01, max_comb=10):
    """items: [(index, amount, extra_data), ...]"""
    n = len(items)
    limit = min(n, max_comb)
    for r in range(2, limit + 1):
        for combo in combinations(items, r):
            if abs(sum(x[1] for x in combo) - target_amount) <= tolerance:
                return list(combo)
    return None

# 3. 按买家/客户分组处理匹配
for key, group_prop in df_proposal.groupby('Clean_Key'):
    if not key:
        continue
        
    group_pay = df_payment[df_payment['Clean_Key'] == key]
    if group_pay.empty:
        continue
        
    unmatched_prop = group_prop.copy()
    unmatched_pay = group_pay.copy()
    
    # ---------------- 场景 0: 整组总金额完全匹配 ----------------
    sum_prop = unmatched_prop['_AMT'].sum()
    sum_pay = unmatched_pay['_AMT'].sum()
    
    if abs(sum_prop - sum_pay) <= 0.01 and sum_prop > 0:
        if len(unmatched_pay) == 1:
            # 1 笔 Payment 对应全组多笔 Proposal
            pay_ref = str(unmatched_pay.iloc[0][col_pay_ref])
            df_proposal.loc[unmatched_prop.index, 'Payment Group Reference'] = pay_ref
            continue
        elif len(unmatched_prop) == 1:
            # 赛诺菲场景：多笔 Payment 凑成 1 笔 Proposal
            all_refs = unmatched_pay[col_pay_ref].dropna().astype(str).unique()
            df_proposal.loc[unmatched_prop.index, 'Payment Group Reference'] = ", ".join(all_refs)
            continue

    # ---------------- 步骤 1: 1 对 1 精确金额匹配 ----------------
    matched_pay_indices = []
    for idx_p, row_p in unmatched_pay.iterrows():
        target_amt = row_p['_AMT']
        pay_ref = str(row_p[col_pay_ref])
        
        matches_1v1 = unmatched_prop[np.isclose(unmatched_prop['_AMT'], target_amt, atol=0.01)]
        if not matches_1v1.empty:
            matched_idx_prop = matches_1v1.index[0]
            df_proposal.loc[matched_idx_prop, 'Payment Group Reference'] = pay_ref
            unmatched_prop = unmatched_prop.drop(matched_idx_prop)
            matched_pay_indices.append(idx_p)
            
    unmatched_pay = unmatched_pay.drop(matched_pay_indices)

    # ---------------- 步骤 2: 1 笔 Payment == 多笔 Proposal 之和 ----------------
    matched_pay_indices = []
    for idx_p, row_p in unmatched_pay.iterrows():
        if unmatched_prop.empty:
            break
        target_amt = row_p['_AMT']
        pay_ref = str(row_p[col_pay_ref])
        
        proposal_items = [(idx, row['_AMT']) for idx, row in unmatched_prop.iterrows() if row['_AMT'] > 0]
        subset = find_subset_match(proposal_items, target_amt)
        if subset:
            matched_prop_idx_list = [item[0] for item in subset]
            df_proposal.loc[matched_prop_idx_list, 'Payment Group Reference'] = pay_ref
            unmatched_prop = unmatched_prop.drop(matched_prop_idx_list)
            matched_pay_indices.append(idx_p)
            
    unmatched_pay = unmatched_pay.drop(matched_pay_indices)

    # ---------------- 步骤 3: 1 笔 Proposal == 多笔 Payment 之和（赛诺菲等分批付款） ----------------
    for idx_prop, row_prop in unmatched_prop.iterrows():
        if unmatched_pay.empty:
            break
        target_amt = row_prop['_AMT']
        
        payment_items = [(idx_p, row_p['_AMT'], str(row_p[col_pay_ref])) 
                         for idx_p, row_p in unmatched_pay.iterrows() if row_p['_AMT'] > 0]
        
        subset = find_subset_match(payment_items, target_amt)
        if subset:
            matched_pay_idx_list = [item[0] for item in subset]
            matched_refs = list(dict.fromkeys([item[2] for item in subset if item[2] not in ['None', 'nan', '']]))
            combined_ref = ", ".join(matched_refs)
            
            df_proposal.loc[idx_prop, 'Payment Group Reference'] = combined_ref
            unmatched_pay = unmatched_pay.drop(matched_pay_idx_list)

# 4. 清理临时字段并输出 Proposal 表到 1 号输出端口
df_proposal = df_proposal.drop(columns=['Clean_Key', '_AMT'])
Alteryx.write(df_proposal, 1)
