from ayx import Alteryx
import pandas as pd
import numpy as np
from itertools import combinations

# 1. 读取输入数据
# 请确保输入 1 连接至 Anchor #1，输入 2 连接至 Anchor #2
df1 = Alteryx.read("#1")
df2 = Alteryx.read("#2")

# 2. 数据预处理（转换金额列为数值型，防止字符串影响计算）
df1['Proposal Total Amount'] = pd.to_numeric(df1['Proposal Total Amount'], errors='coerce').fillna(0.0)
df2['Payment Net Amount'] = pd.to_numeric(df2['Payment Net Amount'], errors='coerce').fillna(0.0)

# 初始化目标字段
df1['Payment Group Reference'] = None

# 通用子集组合求和函数
def find_subset_match(items, target_amount, tolerance=0.01, max_k=10):
    """
    items: [(index, amount, extra_info), ...]
    target_amount: 目标求和金额
    tolerance: 浮点数容差
    """
    n = len(items)
    max_comb_length = min(n, max_k)
    for r in range(2, max_comb_length + 1):
        for combo in combinations(items, r):
            if abs(sum(item[1] for item in combo) - target_amount) <= tolerance:
                return list(combo)
    return None

# 3. 按 Internal Buyer Reference 分组处理匹配逻辑
for ref, group1 in df1.groupby('Internal Buyer Reference'):
    if pd.isna(ref) or str(ref).strip() == '':
        continue
        
    group2 = df2[df2['Internal Buyer Reference'] == ref]
    
    # 场景 A: 输入 2 中未找到匹配的 Reference
    if group2.empty:
        continue
        
    # 场景 B: 仅找到唯一一条 Payment 记录（无歧义，直接全量映射）
    if len(group2) == 1:
        pay_ref = str(group2.iloc[0]['Payment Group Reference'])
        df1.loc[group1.index, 'Payment Group Reference'] = pay_ref
        continue
        
    # 场景 C: 存在多条 Payment 记录（支持 1v1、1对多、多对1、多对多复合匹配）
    unmatched_df1 = group1.copy()
    unmatched_df2 = group2.copy()
    
    # ---------------- 步骤 C1: 1对1 精确金额匹配 ----------------
    matched_df2_indices = []
    for idx2, row2 in unmatched_df2.iterrows():
        target_amt = row2['Payment Net Amount']
        pay_ref = str(row2['Payment Group Reference'])
        
        matches_1v1 = unmatched_df1[np.isclose(unmatched_df1['Proposal Total Amount'], target_amt, atol=0.01)]
        if not matches_1v1.empty:
            matched_idx1 = matches_1v1.index[0]
            df1.loc[matched_idx1, 'Payment Group Reference'] = pay_ref
            unmatched_df1 = unmatched_df1.drop(matched_idx1)
            matched_df2_indices.append(idx2)
            
    unmatched_df2 = unmatched_df2.drop(matched_df2_indices)
    
    # ---------------- 步骤 C2: 1对多匹配（1 笔 Payment == 多笔 Proposal 之和） ----------------
    matched_df2_indices = []
    for idx2, row2 in unmatched_df2.iterrows():
        if unmatched_df1.empty:
            break
            
        target_amt = row2['Payment Net Amount']
        pay_ref = str(row2['Payment Group Reference'])
        
        proposal_items = [(idx1, row1['Proposal Total Amount']) 
                          for idx1, row1 in unmatched_df1.iterrows() if row1['Proposal Total Amount'] > 0]
        
        subset = find_subset_match(proposal_items, target_amt)
        if subset:
            matched_idx1_list = [item[0] for item in subset]
            df1.loc[matched_idx1_list, 'Payment Group Reference'] = pay_ref
            unmatched_df1 = unmatched_df1.drop(matched_idx1_list)
            matched_df2_indices.append(idx2)
            
    unmatched_df2 = unmatched_df2.drop(matched_df2_indices)

    # ---------------- 步骤 C3: 多对1匹配（1 笔 Proposal == 多笔 Payment 之和） ----------------
    matched_df1_indices = []
    for idx1, row1 in unmatched_df1.iterrows():
        if unmatched_df2.empty:
            break
            
        target_amt = row1['Proposal Total Amount']
        payment_items = [(idx2, row2['Payment Net Amount'], str(row2['Payment Group Reference'])) 
                         for idx2, row2 in unmatched_df2.iterrows() if row2['Payment Net Amount'] > 0]
        
        subset = find_subset_match(payment_items, target_amt)
        if subset:
            matched_idx2_list = [item[0] for item in subset]
            # 获取匹配到的多个 Payment 单号（去重）
            matched_refs = list(dict.fromkeys([item[2] for item in subset if item[2] not in ['None', 'nan', '']]))
            df1.loc[idx1, 'Payment Group Reference'] = ", ".join(matched_refs)
            
            unmatched_df2 = unmatched_df2.drop(matched_idx2_list)
            matched_df1_indices.append(idx1)
            
    unmatched_df1 = unmatched_df1.drop(matched_df1_indices)

    # ---------------- 步骤 C4: 多对多整体匹配（多笔 Proposal == 多笔 Payment 总额相等） ----------------
    if not unmatched_df1.empty and not unmatched_df2.empty:
        sum_remain_df1 = unmatched_df1['Proposal Total Amount'].sum()
        sum_remain_df2 = unmatched_df2['Payment Net Amount'].sum()
        
        # 当剩余的多笔 Proposal 总和 与 剩余的多笔 Payment 总和相等时（如 2 笔付款对应 3 笔提报）
        if abs(sum_remain_df1 - sum_remain_df2) <= 0.01 and sum_remain_df1 > 0:
            all_refs = list(dict.fromkeys(unmatched_df2['Payment Group Reference'].dropna().astype(str).tolist()))
            combined_ref = ", ".join(all_refs)
            # 将这组多对多的所有 Proposal 全部挂上对应的多个 Payment 单号
            df1.loc[unmatched_df1.index, 'Payment Group Reference'] = combined_ref

# 4. 写出结果到 Alteryx 输出端口 1
Alteryx.write(df1, 1)
