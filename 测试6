# ==========================================
# 0. 可调整参数
# ==========================================
MAX_PROPOSALS_PER_MATCH = 50
MAX_PAYMENTS_PER_MATCH = 50

# True：输出诊断字段，方便检查客户名和金额转换结果。
# 问题解决后可改为 False。
KEEP_DEBUG_COLUMNS = True


# ==========================================
# 1. 辅助函数
# ==========================================
def normalize_name(value):
    """
    规范客户名称：
    1. Unicode NFKC 规范化（全角转半角等）；
    2. 转小写；
    3. 删除零宽字符、BOM、不间断空格等不可见字符；
    4. 仅保留汉字、英文字母和数字。

    例如以下名称会得到相同匹配键：
    联合利华（中国）有限公司
    联合利华(中国)有限公司
    联合利华 （中国） 有限公司
    """
    if pd.isna(value):
        return None

    text = unicodedata.normalize("NFKC", str(value))
    text = text.casefold()

    text = re.sub(
        r"[\u200b\u200c\u200d\u2060\ufeff\u00a0]",
        "",
        text
    )

    text = re.sub(
        r"[^0-9a-z\u3400-\u4dbf\u4e00-\u9fff]+",
        "",
        text
    )

    return text if text else None


def to_cents(value):
    """使用 ROUND_HALF_UP 将金额转换成整数分。"""
    if pd.isna(value):
        return None

    try:
        cleaned_value = str(value).strip().replace(",", "")

        # 兼容部分数据源以括号表示负数，例如 (1,234.56)。
        if (
            cleaned_value.startswith("(")
            and cleaned_value.endswith(")")
        ):
            cleaned_value = "-" + cleaned_value[1:-1]

        amount = Decimal(cleaned_value).quantize(
            Decimal("0.01"),
            rounding=ROUND_HALF_UP
        )
        return int(amount * 100)
    except Exception:
        return None


def format_money_from_cents(cents):
    """将整数分转换为固定两位小数的字符串。"""
    return f"{Decimal(int(cents)) / Decimal(100):.2f}"


def format_unique_field(record_list, field_name):
    """去除空值，并按照原顺序去重拼接。"""
    valid_values = []
    seen = set()

    for record in record_list:
        value = record.get(field_name)

        if pd.isna(value):
            continue

        string_value = str(value).strip()

        if not string_value or string_value in seen:
            continue

        valid_values.append(string_value)
        seen.add(string_value)

    return ", ".join(valid_values) if valid_values else None


def find_best_subset(records, target, max_items):
    """
    寻找金额合计严格等于 target 的记录组合。

    规则：
    1. 优先使用记录数量最少的组合；
    2. 相同数量时，按金额降序和内部行号返回第一个组合；
    3. 常规组合只使用正金额记录；
    4. target 为 0 时，允许匹配一笔零金额记录。
    """
    if target < 0:
        return None

    positive_records = [
        record for record in records
        if record["amount"] > 0
    ]
    zero_records = [
        record for record in records
        if record["amount"] == 0
    ]

    if target == 0:
        return [zero_records[0]] if zero_records else None

    sorted_records = sorted(
        positive_records,
        key=lambda record: (-record["amount"], record["row_id"])
    )

    record_count = len(sorted_records)
    if record_count == 0:
        return None

    max_items = min(max_items, record_count)

    # 先找 1 笔，再找 2 笔，以此类推。
    for required_count in range(1, max_items + 1):
        result = None

        def dfs(start_index, remaining, current_subset):
            nonlocal result

            if result is not None:
                return

            slots_left = required_count - len(current_subset)

            if slots_left == 0:
                if remaining == 0:
                    result = list(current_subset)
                return

            available_count = record_count - start_index
            if available_count < slots_left or remaining < 0:
                return

            # 只用当前递归位置之后仍然可选的记录计算上下界。
            remaining_records = sorted_records[start_index:]

            max_possible = sum(
                record["amount"]
                for record in remaining_records[:slots_left]
            )
            min_possible = sum(
                record["amount"]
                for record in remaining_records[-slots_left:]
            )

            if remaining > max_possible or remaining < min_possible:
                return

            last_amount = None
            maximum_index = record_count - slots_left

            for index in range(start_index, maximum_index + 1):
                record = sorted_records[index]
                amount = record["amount"]

                # 同一递归层跳过相同金额，避免重复搜索。
                if last_amount is not None and amount == last_amount:
                    continue
                last_amount = amount

                if amount > remaining:
                    continue

                current_subset.append(record)
                dfs(index + 1, remaining - amount, current_subset)
                current_subset.pop()

                if result is not None:
                    return

        dfs(0, target, [])

        if result is not None:
            return result

    return None


# ==========================================
# 2. 读取 Alteryx 输入
# ==========================================
df_proposal = Alteryx.read("#1")
df_payment = Alteryx.read("#2")


# ==========================================
# 3. 检查并规范列名
# ==========================================
if "proposal_key" not in df_proposal.columns:
