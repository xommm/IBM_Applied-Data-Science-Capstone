from ayx import Package
from ayx import Alteryx
import pandas as pd
from itertools import combinations
from decimal import Decimal, ROUND_HALF_UP
import re
import unicodedata
import numpy as np

# ==========================================
# 0. 可调整参数
# ==========================================
MAX_PROPOSALS_PER_MATCH = 50  # 适度放宽组合笔数上限（防止全量数据下溢出）
MAX_PAYMENTS_PER_MATCH = 50

ENABLE_DEBUG_DIAGNOSTICS = True  # 生成诊断列用于排查金额/客户键问题


# ==========================================
# 1. 辅助函数（针对 Alteryx 类型转换增强）
# ==========================================
def normalize_name(value):
    """
    规范客户名称：
    剔除全角/半角差异、空格、Null字节(\x00)、BOM(\ufeff)及不可见字符
    """
    if pd.isna(value):
        return None

    s = str(value)
    # 彻底清理 Alteryx V_WString 常见的 Null 字节与 BOM 头
    s = s.replace("\x00", "").replace("\ufeff", "")
    text = unicodedata.normalize("NFKC", s).strip()

    if not text:
        return None

    # 去掉零宽字符、非打印字符、不间断空格
    text = re.sub(r"[\u200B-\u200D\uFEFF\u00A0]", "", text)
    # 去掉所有空白字符（包括全角空格 \u3000）
    text = re.sub(r"\s+", "", text)
    text = text.lower()
    text = text.replace("（", "(").replace("）", ")")
    text = re.sub(r"[^0-9a-zA-Z\u4e00-\u9fff\(\)\-\,\.\u00b7]", "", text)

    return text if text else None


def to_cents(value):
    """
    将金额转换为整数分（ROUND_HALF_UP）。
    彻底解决 Alteryx Double 浮点数科学计数法 (如 1.017e+06) 及 V_WString 格式干扰。
    """
    if pd.isna(value):
        return None

    # 1. 处理数字类型 (Alteryx Double / Float / Int)
    if isinstance(value, (float, np.floating)):
        if np.isnan(value) or np.isinf(value):
            return None
        # 强制格式化为两位小数文本，杜绝科学计数法和浮点数尾数噪声
        num_str = f"{value:.2f}"
    elif isinstance(value, (int, np.integer)):
        num_str = str(value)
    else:
        # 2. 处理文本类型 (Alteryx V_WString / String)
        s = unicodedata.normalize("NFKC", str(value)).strip()
        if not s:
            return None

        s = s.replace(",", "").replace("．", ".").replace("。", ".")
        
        # 匹配可能包含科学计数法或普通小数的数值字符串
        m = re.search(r"[-]?\d+(\.\d+)?([eE][+-]?\d+)?", s)
        if not m:
            return None
        num_str = m.group(0)

    try:
        amt = Decimal(num_str).quantize(
            Decimal("0.01"),
            rounding=ROUND_HALF_UP
        )
        return int(amt * 100)
    except Exception:
        return None


def format_money_from_cents(cents):
    """将整数分转换为固定两位小数的字符串。"""
    if cents is None:
        return None
    return f"{Decimal(int(cents)) / Decimal(100):.2f}"


def format_unique_field(record_list, field_name):
    """去除空值并按原顺序去重拼接。"""
    valid_values = []
    seen = set()

    for record in record_list:
        value = record.get(field_name)

        if pd.isna(value):
            continue

        string_value = str(value).strip()

        if not string_value or string_value in seen:
            continue

        valid_values.append(string_value)
        seen.add(string_value)

    return ", ".join(valid_values) if valid_values else None


def find_best_subset(records, target, max_items):
    """在 records 中寻找金额合计等于 target 的组合（整数分精确匹配）。"""
    if target < 0:
        return None

    positive_records = [r for r in records if r["amount"] > 0]
    zero_records = [r for r in records if r["amount"] == 0]

    if target == 0:
        return [zero_records[0]] if zero_records else None

    sorted_records = sorted(
        positive_records,
        key=lambda r: (-r["amount"], r["row_id"])
    )

    record_count = len(sorted_records)
    if record_count == 0:
        return None

    max_items = min(max_items, record_count)

    for required_count in range(1, max_items + 1):
        result = None

        def dfs(start_index, remaining, current_subset):
            nonlocal result

            if result is not None:
                return

            selected_count = len(current_subset)
            slots_left = required_count - selected_count

            if slots_left == 0:
                if remaining == 0:
                    result = list(current_subset)
                return

            if record_count - start_index < slots_left:
                return

            if remaining < 0:
                return

            max_possible = sum(
                sorted_records[i]["amount"]
                for i in range(start_index, start_index + slots_left)
            )
            min_possible = sum(
                sorted_records[i]["amount"]
                for i in range(record_count - slots_left, record_count)
            )

            if remaining > max_possible or remaining < min_possible:
                return

            last_amount = None

            for index in range(start_index, record_count - slots_left + 1):
                record = sorted_records[index]
                amount = record["amount"]

                if last_amount is not None and amount == last_amount:
                    continue
                last_amount = amount

                if amount > remaining:
                    continue

                current_subset.append(record)
                dfs(index + 1, remaining - amount, current_subset)
                current_subset.pop()

                if result is not None:
                    return

        dfs(0, target, [])

        if result is not None:
            return result

    return None


# ==========================================
# 2. 读取 Alteryx 输入
# ==========================================
df_proposal = Alteryx.read("#1")
df_payment = Alteryx.read("#2")


# ==========================================
# 3. 检查并规范列名
# ==========================================
if "proposal_key" not in df_proposal.columns:
    if "Record" in df_proposal.columns:
        df_proposal["proposal_key"] = df_proposal["Record"]
    else:
        raise ValueError("Proposal 输入缺少 proposal_key 或 Record 字段。")
else:
    # 针对 proposal_key 列全是 NaN 时的补齐容错
    if df_proposal["proposal_key"].isna().all() and "Record" in df_proposal.columns:
        df_proposal["proposal_key"] = df_proposal["Record"]

if "payment_key" not in df_payment.columns:
    if "Record" in df_payment.columns:
        df_payment["payment_key"] = df_payment["Record"]

required_proposal_columns = [
    "proposal_key",
    "Buyer Name (Local)",
    "Proposal Total Amount"
]
required_payment_columns = [
    "payment_key",
    "Client_Name",
    "Yesterday_Balance"
]

missing_proposal_columns = [
    c for c in required_proposal_columns if c not in df_proposal.columns
]
missing_payment_columns = [
    c for c in required_payment_columns if c not in df_payment.columns
]

if missing_proposal_columns:
    raise ValueError("Proposal 输入缺少字段：" + ", ".join(missing_proposal_columns))
if missing_payment_columns:
    raise ValueError("Payment 输入缺少字段：" + ", ".join(missing_payment_columns))

optional_payment_columns = [
    "Debit Account",
    "Debtor_Agent_Name",
    "Debtor Agent Party ID"
]

for col in optional_payment_columns:
    if col not in df_payment.columns:
        df_payment[col] = None


# ==========================================
# 4. 创建内部唯一行号并清洗数据
# ==========================================
df_proposal = df_proposal.copy()
df_payment = df_payment.copy()

df_proposal["_proposal_row_id"] = range(len(df_proposal))
df_payment["_payment_row_id"] = range(len(df_payment))

df_proposal["_client_match_key"] = df_proposal["Buyer Name (Local)"].apply(normalize_name)
df_payment["_client_match_key"] = df_payment["Client_Name"].apply(normalize_name)

if ENABLE_DEBUG_DIAGNOSTICS:
    df_proposal["_debug_proposal_raw_amount"] = df_proposal["Proposal Total Amount"]
    df_payment["_debug_payment_raw_amount"] = df_payment["Yesterday_Balance"]
    df_proposal["_debug_proposal_raw_name"] = df_proposal["Buyer Name (Local)"]
    df_payment["_debug_payment_raw_name"] = df_payment["Client_Name"]

# 金额转整数分（自动判定 Double 浮点数与 V_WString 字符串）
df_proposal["_amount_cents"] = df_proposal["Proposal Total Amount"].apply(to_cents)
df_payment["_amount_cents"] = df_payment["Yesterday_Balance"].apply(to_cents)

if ENABLE_DEBUG_DIAGNOSTICS:
    df_proposal["_debug_proposal_client_key"] = df_proposal["_client_match_key"]
    df_payment["_debug_payment_client_key"] = df_payment["_client_match_key"]

df_proposal_clean = df_proposal.dropna(
    subset=["proposal_key", "_client_match_key", "_amount_cents"]
).copy()
df_payment_clean = df_payment.dropna(
    subset=["payment_key", "_client_match_key", "_amount_cents"]
).copy()

df_proposal_clean["_amount_cents"] = df_proposal_clean["_amount_cents"].astype(int)
df_payment_clean["_amount_cents"] = df_payment_clean["_amount_cents"].astype(int)


# ==========================================
# 5. 保存匹配结果
# ==========================================
match_results = {}
matched_payment_row_ids = set()


def save_match(proposal_records, payment_records):
    proposal_count = len(proposal_records)
    payment_count = len(payment_records)

    if proposal_count == 1 and payment_count == 1:
        match_type = "One-to-One"
    elif proposal_count > 1 and payment_count == 1:
        match_type = "Many-Proposals-to-One-Payment"
    elif proposal_count == 1 and payment_count > 1:
        match_type = "One-Proposal-to-Many-Payments"
    else:
        match_type = "Many-to-Many"

    target_cents = sum(p["amount"] for p in proposal_records)

    payment_ids_string = ", ".join(str(p["id"]) for p in payment_records)
    payment_amounts_string = ", ".join(format_money_from_cents(p["amount"]) for p in payment_records)
    proposal_ids_string = ", ".join(str(pr["id"]) for pr in proposal_records)

    debit_account_string = format_unique_field(payment_records, "Debit Account")
    debtor_agent_name_string = format_unique_field(payment_records, "Debtor_Agent_Name")
    debtor_agent_party_id_string = format_unique_field(payment_records, "Debtor Agent Party ID")

    result = {
        "Matched_Payment_IDs": payment_ids_string,
        "Matched_Payment_Amounts": payment_amounts_string,
        "Matched_Debit_Account": debit_account_string,
        "Matched_Debtor_Agent_Name": debtor_agent_name_string,
        "Matched_Debtor_Agent_Party_ID": debtor_agent_party_id_string,
        "Group_Matched_Proposals": proposal_ids_string if proposal_count > 1 else None,
        "Group_Target_Sum": (target_cents / 100.0) if proposal_count > 1 else None,
        "Match_Type": match_type,
        "Matched_Proposal_Count": proposal_count,
        "Matched_Payment_Count": payment_count
    }

    for proposal in proposal_records:
        match_results[proposal["row_id"]] = result.copy()

    for payment in payment_records:
        matched_payment_row_ids.add(payment["row_id"])


# ==========================================
# 6. 按标准化客户名称执行匹配
# ==========================================
for client_key, proposal_group in df_proposal_clean.groupby("_client_match_key", sort=False):
    payment_group = df_payment_clean[df_payment_clean["_client_match_key"] == client_key]

    if payment_group.empty:
        continue

    available_proposals = []
    for _, row in proposal_group.iterrows():
        available_proposals.append({
            "row_id": int(row["_proposal_row_id"]),
            "id": row["proposal_key"],
            "amount": int(row["_amount_cents"])
        })

    available_payments = []
    for _, row in payment_group.iterrows():
        available_payments.append({
            "row_id": int(row["_payment_row_id"]),
            "id": row["payment_key"],
            "amount": int(row["_amount_cents"]),
            "Debit Account": row["Debit Account"],
            "Debtor_Agent_Name": row["Debtor_Agent_Name"],
            "Debtor Agent Party ID": row["Debtor Agent Party ID"]
        })

    available_proposals.sort(key=lambda r: (-r["amount"], r["row_id"]))
    available_payments.sort(key=lambda r: (-r["amount"], r["row_id"]))

    # 阶段 A：同金额一对一
    progress = True
    while progress and available_proposals and available_payments:
        progress = False

        payment_by_amount = {}
        for pay in available_payments:
            payment_by_amount.setdefault(pay["amount"], []).append(pay)

        for proposal in list(available_proposals):
            if proposal["amount"] not in payment_by_amount:
                continue

            matched_payment = payment_by_amount[proposal["amount"]][0]
            save_match([proposal], [matched_payment])

            available_proposals = [p for p in available_proposals if p["row_id"] != proposal["row_id"]]
            available_payments = [p for p in available_payments if p["row_id"] != matched_payment["row_id"]]
            progress = True
            break

    # 阶段 B：一笔 Payment 匹配多笔 Proposal（proposal>=2）
    progress = True
    while progress and available_proposals and available_payments:
        progress = False

        for payment in list(available_payments):
            proposal_subset = find_best_subset(
                available_proposals,
                payment["amount"],
                MAX_PROPOSALS_PER_MATCH
            )

            if not proposal_subset or len(proposal_subset) < 2:
                continue

            save_match(proposal_subset, [payment])

            used_proposal_rows = {p["row_id"] for p in proposal_subset}
            available_proposals = [p for p in available_proposals if p["row_id"] not in used_proposal_rows]
            available_payments = [pay for pay in available_payments if pay["row_id"] != payment["row_id"]]

            progress = True
            break

    # 阶段 C：一笔 Proposal 匹配多笔 Payment（payment>=2）
    progress = True
    while progress and available_proposals and available_payments:
        progress = False

        for proposal in list(available_proposals):
            payment_subset = find_best_subset(
                available_payments,
                proposal["amount"],
                MAX_PAYMENTS_PER_MATCH
            )

            if not payment_subset or len(payment_subset) < 2:
                continue

            save_match([proposal], payment_subset)

            available_proposals = [p for p in available_proposals if p["row_id"] != proposal["row_id"]]
            used_payment_rows = {pay["row_id"] for pay in payment_subset}
            available_payments = [pay for pay in available_payments if pay["row_id"] not in used_payment_rows]

            progress = True
            break

    # 阶段 D：多 Proposal 对多 Payment（双方>=2）
    progress = True
    while progress and available_proposals and available_payments:
        progress = False

        maximum_proposal_count = min(MAX_PROPOSALS_PER_MATCH, len(available_proposals))

        for proposal_count in range(2, maximum_proposal_count + 1):
            matched_at_this_level = False

            for proposal_combo in combinations(available_proposals, proposal_count):
                target_cents = sum(p["amount"] for p in proposal_combo)

                payment_subset = find_best_subset(
                    available_payments,
                    target_cents,
                    MAX_PAYMENTS_PER_MATCH
                )

                if not payment_subset or len(payment_subset) < 2:
                    continue

                save_match(list(proposal_combo), payment_subset)

                used_proposal_rows = {p["row_id"] for p in proposal_combo}
                used_payment_rows = {pay["row_id"] for pay in payment_subset}

                available_proposals = [p for p in available_proposals if p["row_id"] not in used_proposal_rows]
                available_payments = [pay for pay in available_payments if pay["row_id"] not in used_payment_rows]

                progress = True
                matched_at_this_level = True
                break

            if matched_at_this_level:
                break


# ==========================================
# 7. 将匹配结果回填 Proposal
# ==========================================
def get_match_value(proposal_row_id, column_name):
    if pd.isna(proposal_row_id):
        return None

    result = match_results.get(int(proposal_row_id))
    if result is None:
        return None

    return result.get(column_name)


result_columns = [
    "Matched_Payment_IDs",
    "Matched_Payment_Amounts",
    "Matched_Debit_Account",
    "Matched_Debtor_Agent_Name",
    "Matched_Debtor_Agent_Party_ID",
    "Group_Matched_Proposals",
    "Group_Target_Sum",
    "Match_Type",
    "Matched_Proposal_Count",
    "Matched_Payment_Count"
]

for column_name in result_columns:
    df_proposal[column_name] = df_proposal["_proposal_row_id"].apply(
        lambda rid, col=column_name: get_match_value(rid, col)
    )


# ==========================================
# 8. 获取未匹配 Payment
# ==========================================
df_unmatched_payments = df_payment[
    ~df_payment["_payment_row_id"].isin(matched_payment_row_ids)
].copy()


# ==========================================
# 9. 删除内部辅助字段
# ==========================================
proposal_internal_columns = [
    "_proposal_row_id",
    "_client_match_key",
    "_amount_cents"
]

payment_internal_columns = [
    "_payment_row_id",
    "_client_match_key",
    "_amount_cents"
]

df_proposal = df_proposal.drop(columns=[c for c in proposal_internal_columns if c in df_proposal.columns])
df_unmatched_payments = df_unmatched_payments.drop(columns=[c for c in payment_internal_columns if c in df_unmatched_payments.columns])

if not ENABLE_DEBUG_DIAGNOSTICS:
    diag_cols = [
        "_debug_proposal_raw_amount",
        "_debug_payment_raw_amount",
        "_debug_proposal_raw_name",
        "_debug_payment_raw_name",
        "_debug_proposal_client_key",
        "_debug_payment_client_key"
    ]
    for col in diag_cols:
        if col in df_proposal.columns:
            df_proposal = df_proposal.drop(columns=[col])
        if col in df_unmatched_payments.columns:
            df_unmatched_payments = df_unmatched_payments.drop(columns=[col])


# ==========================================
# 10. 写入 Alteryx 输出端口
# ==========================================
Alteryx.write(df_proposal, 1)
Alteryx.write(df_unmatched_payments, 2)
